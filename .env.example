NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Product name in titles, logo alt text, emails, and the copyright line.
# Production: Souvenir - Gifting Solutions
# Placeholder values (Gifting Solutions, Giffter, Oaklane, souvenir-gifting-crm) are ignored.
NEXT_PUBLIC_APP_NAME=Souvenir - Gifting Solutions
# Short label for the PWA, install hint, and compact UI. Production: Souvenir
NEXT_PUBLIC_APP_SHORT_NAME=Souvenir
# Canonical public origin (www). Apex giftingstore.online is the same CRM.
# Used for metadataBase and Open Graph. Production:
# souvenir-gifting-crm.vercel.app is ignored and falls back to this origin.
NEXT_PUBLIC_SITE_URL=https://www.giftingstore.online
# Optional marketing site. Not the CRM, not company portals, and not an auth redirect host.
# Leave unset until that hostname should appear in the public footer.
# NEXT_PUBLIC_MARKETING_URL=https://souvenirgifting.com

# Server-only. Required for admin-created client portal logins.
# Never expose this to the browser. Do not use NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Company portals: https://{slug}.ROOT_DOMAIN
# Production: giftingstore.online
# Unset, localhost, and *.vercel.app stay the main CRM (apex and www do too).
# Safe to copy locally: localhost is not a label under this domain.
# Attach giftingstore.online and *.giftingstore.online to the same Vercel project,
# then add https://*.giftingstore.online/** to Supabase Auth redirect URLs.
# Redeploy after setting this so the proxy sees it.
# Do not set this to souvenirgifting.com.
ROOT_DOMAIN=giftingstore.online
# Portal DNS. Leave unset on Vercel — wildcard DNS is assumed and Hostinger is not called.
# PORTAL_DNS=hostinger is a local-only rollback (pair with HOSTINGER_MOCK=1).
# It is ignored when VERCEL=1 or NODE_ENV=production.
# PORTAL_DNS=
# Deprecated for production. Hostinger parked-domain provisioning does not run on Vercel.
# These remain only for a local PORTAL_DNS=hostinger experiment. Never commit values.
# HOSTINGER_API_TOKEN=
# HOSTINGER_ACCOUNT_USERNAME=
# HOSTINGER_WEBSITE_DOMAIN=
# Optional shared secret for POST /api/internal/portal-hosts/run.
# That route no longer calls Hostinger; it only reconciles portal_hosts rows.
# A Hostinger cron hitting it is unnecessary once the wildcard is live.
# CRON_SECRET=
# Unused on Vercel (old Hostinger parked-domain capacity thresholds).
# PORTAL_PARKED_SOFT_LIMIT=
# PORTAL_PARKED_HARD_LIMIT=
# Local mock for PORTAL_DNS=hostinger. Refused when NODE_ENV=production.
# HOSTINGER_MOCK=
# Transactional email via Resend (server-only). Used by password reset and catalog share links.
# Leave RESEND_API_KEY empty to disable sending; staff can still copy a share link or open their mail app.
# onboarding@resend.dev only delivers to the Resend account's own address.
# Verify a domain in the Resend dashboard, then set RESEND_FROM_EMAIL to send to clients.
# Example production sender once catalogs.giftingstore.online (or the apex) is verified in Resend:
# RESEND_FROM_EMAIL=Souvenir - Gifting Solutions <catalogs@giftingstore.online>
RESEND_API_KEY=
RESEND_FROM_EMAIL=
