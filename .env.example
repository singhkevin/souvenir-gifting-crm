NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_NAME=Gifting Solutions
# Server-only. Required for admin-created client portal logins.
# Never expose this to the browser. Do not use NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Host that company portals hang from: https://{slug}.ROOT_DOMAIN
# Unset, localhost, and *.vercel.app stay the main site.
# Example: brand.com, or gifts.brand.com when the apex already has a website.
# After DNS is live, add https://*.ROOT_DOMAIN/** to Supabase Auth redirect URLs.
ROOT_DOMAIN=
# Hostinger parked-domain provisioning (server-only; set in hPanel, never commit values)
HOSTINGER_API_TOKEN=
HOSTINGER_ACCOUNT_USERNAME=
HOSTINGER_WEBSITE_DOMAIN=
# Shared secret for POST /api/internal/portal-hosts/run (Hostinger cron)
CRON_SECRET=
# Optional capacity thresholds (defaults 250 / 290 of Hostinger's 300)
PORTAL_PARKED_SOFT_LIMIT=
PORTAL_PARKED_HARD_LIMIT=
# Local/dev only. Never set in production.
HOSTINGER_MOCK=
# Transactional email via Resend (server-only). Used by password reset and catalog share links.
# Leave RESEND_API_KEY empty to disable sending; staff can still copy a share link or open their mail app.
# onboarding@resend.dev only delivers to the Resend account's own address.
# Verify a domain in the Resend dashboard, then set RESEND_FROM_EMAIL to send to clients.
# Example: Souvenir Gifting Solutions <catalogs@giftingstore.online>
RESEND_API_KEY=
RESEND_FROM_EMAIL=
