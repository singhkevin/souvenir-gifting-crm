NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_NAME=Gifting Solutions
# Server-only. Required for admin-created client portal logins.
# Never expose this to the browser. Do not use NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Host that company portals hang from: https://{slug}.ROOT_DOMAIN
# Unset, localhost, and *.vercel.app stay the main site.
# Example: brand.com, or gifts.brand.com when the apex already has a website.
# After DNS is live, add https://*.ROOT_DOMAIN/** to Supabase Auth redirect URLs.
ROOT_DOMAIN=
